# Copiar a .env y completar. El .env NO se sube a GitHub.
# Son las mismas variables de Oracle que usa cpe_bolsatech.py.

SQLPLUS_EXE=D:\oracle\product\11.2.0\client_1\bin\sqlplus.exe
ORACLE_USUARIO=
ORACLE_PASSWORD=
ORACLE_ALIAS=BASE

# CUIT destinatario/destino por defecto (Rivara S.A.)
CUIT_EMPRESA=30601191640
# CUIT por número de planta ONCCA (PLA_NUMERO_ONCCA), igual que en Bolsatech
MAPA_PLANTA_CUIT=525045:30716318989

# IPL_ESPECIE -> código de grano ARCA que espera Visec. COMPLETAR.
# Ej (formato): MAPA_ESPECIE_PRODUCTO=08:23,14:23
MAPA_ESPECIE_PRODUCTO=

# IPL_TIPO_INGRESO -> "Tipo Movimiento" de Visec. COMPLETAR con lo que indique Visec.
# Ej (formato): MAPA_TIPO_MOVIMIENTO=E:XXX,C:XXX,T:XXX
MAPA_TIPO_MOVIMIENTO=

# Tipos de ingreso a incluir por defecto (vacío = todos). Ej: E,C,T
TIPOS_INGRESO=

FORMATO_FECHA_HORA=%d/%m/%Y %H:%M
FORMATO_FECHA=%d/%m/%Y
