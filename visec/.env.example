# Copiar a .env y completar. El .env NO se sube a GitHub.

# --- Conexión a la base del sistema (solo para --desde/--hasta) ---
# Firebird 3+:  firebird+firebird://USUARIO:CLAVE@HOST:3050//ruta/a/base.fdb?charset=WIN1252
# Firebird 2.5: firebird+fdb://USUARIO:CLAVE@HOST:3050//ruta/a/base.fdb?charset=WIN1252
DB_URL=

# --- Datos de la empresa (destinatario / destino de las CPE) ---
CUIT_EMPRESA=30601191640

# --- Mapeos (formato clave:valor separados por coma) ---
# IPL_ESPECIE -> código de grano AFIP/ARCA que espera Visec. COMPLETAR.
# Ej: MAPA_ESPECIE_PRODUCTO=051:XX,06:XX,01:XX,08:XX
MAPA_ESPECIE_PRODUCTO=

# IPL_PLANTA -> Número RUCA de la planta destino. COMPLETAR.
# Ej: MAPA_PLANTA_RUCA=1:12345,2:23456,3:34567
MAPA_PLANTA_RUCA=

# IPL_TIPO_INGRESO -> "Tipo Movimiento" que pide Visec. COMPLETAR con los valores que indique Visec.
# Ej: MAPA_TIPO_MOVIMIENTO=E:INGRESO,C:INGRESO,T:INGRESO
MAPA_TIPO_MOVIMIENTO=

# Tipos de ingreso a incluir por defecto (vacío = todos). Ej: E,C,T
TIPOS_INGRESO=

# Formatos de fecha en el XLSX
FORMATO_FECHA_HORA=%d/%m/%Y %H:%M
FORMATO_FECHA=%d/%m/%Y
