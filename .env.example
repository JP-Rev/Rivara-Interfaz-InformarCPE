# Copiar a .env, completar y dejarlo solo para el dueño:
#   cp .env.example .env && nano .env && chmod 600 .env
# El .env no se sube al repo (.gitignore lo excluye).

# --- ARCA (WSAA + wscpe) ---------------------------------------------------
# homologacion o produccion. Arrancar siempre en homologacion.
ARCA_ENTORNO=homologacion

# Certificados digitales, uno por CUIT habilitado a consultar el WS:
#   ARCA_CERTIFICADOS=cuit:/certs/cert.crt:/certs/clave.key,otro:...:...
# Las rutas son las de DENTRO del contenedor. /certs es
# /storage/informarcpe/certs del host, montado de solo lectura.
# Una CPE la puede consultar solo quien intervino en ella, asi que si alguna
# planta esta a nombre de otra sociedad hace falta tambien su certificado.
ARCA_CERTIFICADOS=30601191640:/certs/rivara.crt:/certs/rivara.key

# Vacio = lo que declara el WSDL real (no el manual v2.0.5, que dice "arca"
# pero el servicio sigue en el host de AFIP):
#   produccion  https://cpea-ws.afip.gob.ar/wscpe/services/soap
#   namespace   https://serviciosjava.afip.gob.ar/wscpe/
# Si ARCA mueve algo, se corrige aca. Es el endpoint SOAP, sin "?wsdl".
ARCA_URL_WSCPE=
ARCA_URL_WSAA=
ARCA_NS_WSCPE=

ARCA_TIMEOUT=60
# Guarda la respuesta cruda de cada CPE en /data/cache/respuestas. Sirve para
# auditar y para completar el mapeo de las columnas que falten.
ARCA_GUARDAR_RESPUESTAS=true

# --- Columnas que no salen de ARCA ----------------------------------------
# codGrano de ARCA -> Codigo Producto de Visec. Si Visec usa el mismo codigo
# que ARCA, dejalo vacio y se copia tal cual.
# Ej: MAPA_GRANO_VISEC=23:23
MAPA_GRANO_VISEC=

# Valor fijo para esas dos columnas de la plantilla. COMPLETAR con lo que
# indique Visec.
TIPO_MOVIMIENTO=
ULTIMO_ALMACENAMIENTO=

# Formato del numero de CPE y de las fechas en el XLSX.
FORMATO_NUMERO_CPE={sucursal:05d}-{nro_orden:08d}
FORMATO_FECHA_HORA=%d/%m/%Y %H:%M
FORMATO_FECHA=%d/%m/%Y

# --- Sesion compartida con el portal --------------------------------------
# El MISMO valor que el .env del portal: es lo que hace que la cookie
# rivara_he que emite el portal la acepte tambien esta app.
JWT_SECRET=

# El enlace "Volver al portal" se arma con el host por el que entro el
# navegador, asi que funciona igual por IP que por nombre. Solo hace falta
# PORTAL_URL si el portal esta en otra maquina.
PORTAL_PUERTO=1003
PORTAL_URL=
# Solo para desarrollo local, saltea el control de sesion.
AUTH_DESACTIVADA=false

# --- Correo (avisos de vencimiento del certificado) -------------------------
# Office 365: smtp.office365.com, puerto 587 (STARTTLS). Los mismos datos que
# el .env de cpe_bolsatech.py. Con el puerto 465 se usa SSL directo.
SMTP_HABILITADO=true
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente: vacio = SMTP_USER. Office 365 solo deja mandar como la cuenta
# que se autentica (o una con permiso "Enviar como").
SMTP_FROM=
# Destinatarios del aviso, separados por coma.
SMTP_TO=jreale@rivara.com.ar

# Dias antes del vencimiento en que se avisa (un mail por umbral).
CERT_AVISO_DIAS=30,15,7,3,1
CERT_CHEQUEO_HORAS=12
# Direccion de esta app, para el link del mail. Ej: http://192.168.0.200:1009
APP_URL=

# --- Limites y retencion ---------------------------------------------------
MAX_CTG=200

# Rutas dentro del contenedor. /data es /storage/informarcpe del host.
SALIDA_DIR=/data/salida
CACHE_DIR=/data/cache

# /storage se respalda, asi que los archivos generados se borran solos.
# 0 = no borrar nunca.
RETENCION_SALIDA_DIAS=30
RETENCION_RESPUESTAS_DIAS=365

# --- ERP (Oracle) --------------------------------------------------------
# De aca salen los ingresos a planta para armar la planilla de Albor, por CTG.
# La base es Oracle 11.2, asi que la imagen trae el Instant Client (Dockerfile).
# ORACLE_DSN tiene la forma host:puerto/service_name.
ORACLE_DSN=192.168.0.20:1521/base
# Conviene un usuario con permiso de SELECT solamente, no el dueno del esquema.
ORACLE_USUARIO=
ORACLE_PASSWORD=
# Un esquema por sociedad: ESQUEMA:Nombre para mostrar, separados por coma.
ORACLE_ESQUEMAS=SYSADMIN:Rivara,SYSADMIN_ELN:La Tranquera Verde,SYSADMIN_PRA:Pradera Natural

# --- Planilla de Albor ---------------------------------------------------
# El numero de ticket del ERP no sirve en Albor: se numera aparte, correlativo,
# arrancando arriba de este valor.
ALBOR_TICKET_DESDE=1000000
# Como se escriben los valores, por si Albor los rechaza.
# ALBOR_SOLO_CODIGO=1          # 1: "02836"   0: "02836 - El Bagual LTV 15 ..."
# ALBOR_SEPARADOR_DECIMAL=,
# ALBOR_FORMATO_FECHA=%d/%m/%Y
# ALBOR_TIPO_FLETE=T           # T Tercero, I Interno

# --- BolsaTech (SIBIO) ---------------------------------------------------
# Se informan las CPE de soja para el muestreo de biotecnologias.
# OJO: esta seccion ESCRIBE en un sistema externo. Un alta registrada no se
# deshace desde la app; hay que pedir la baja del otro lado.
BOLSATECH_URL=https://sibio-arg.com.ar/industrysystem-ws-ar/services/GestionarCartasDePortePE/v4
# Sin esta, las altas quedan registradas pero sin confirmar el trackId.
BOLSATECH_TRACK_URL=https://sibio-arg.com.ar/industrysystem-ws-ar/services/GestionarTrackId
BOLSATECH_TIMEOUT=60

# Dos cuentas. Cual se usa lo decide el prefijo del id de muestra.
BOLSATECH_USUARIO_RIVARA=ws_rivara
BOLSATECH_PASSWORD_RIVARA=
BOLSATECH_USUARIO_MLIAUDAT=ws_mliaudat
BOLSATECH_PASSWORD_MLIAUDAT=
BOLSATECH_PREFIJO_MLIAUDAT=779

# Especies del ERP que se informan (todas variantes de soja).
BOLSATECH_ESPECIES=08,14,20,24,38
# Codigo SAGPyA que se manda si el ERP no lo trae. 23 es soja.
BOLSATECH_ESPECIE_DEFECTO=23

# Por planta, segun su numero ONCCA: ONCCA:localidad:puerto:prefijo_id_muestra
# El '*' es el valor para cualquier otra planta.
BOLSATECH_PLANTAS=525045:1170:7790:7790,*:252:5150:5140
# Quien recibe la mercaderia, por planta: ONCCA:CUIT:razon social
BOLSATECH_DESTINATARIOS=525045:30716318989:Pradera Natural S.A.,*:30601191640:Rivara S.A.

# --- La corrida por fechas (lo que antes era la tarea programada) ---
# En true, la app busca sola los ingresos nuevos y los informa. Apagado por
# defecto a proposito: informa a un sistema externo sin que nadie mire.
BOLSATECH_AUTOMATICO=false
# Cada cuantas horas se repite la corrida automatica
BOLSATECH_CADA_HORAS=6
# Desde cuando buscar la primera vez (AAAA-MM-DD). Despues la app se acuerda
# sola en /data/bolsatech/ultima_corrida.txt
BOLSATECH_FECHA_INICIAL=2026-01-01
# Minutos que se le restan al desde, para no perder un ingreso que entro justo
# mientras corria la busqueda anterior
BOLSATECH_SOLAPAMIENTO_MINUTOS=5
# Cuantas CPE informa como maximo cada corrida. Si quedan afuera, la fecha de
# corte no avanza y la proxima corrida las toma.
BOLSATECH_LIMITE=200

# ===========================================================================
# Visec por API (el XLSX de "Informar Visec" sigue aparte, sin cambios)
# ===========================================================================
# stg o prd. Arranca en staging: pasar a produccion es cambiar esto y las
# credenciales, que son distintas en cada ambiente.
VISEC_API_AMBIENTE=stg
# Las da Visec. Van solo aca, nunca en el codigo ni en GitHub.
VISEC_API_CLIENT_ID=
VISEC_API_CLIENT_SECRET=
# CUIT que informa, sin guiones: va en el header current-company
VISEC_API_CUIT=30601191640
VISEC_API_TIMEOUT=60
# Especies del ERP que van a Visec (38 = Soja EUDR, la de ctg_soja.py)
VISEC_API_ESPECIES=38
# Los egresos tambien van a Visec (EGRESOS_PLANTAS). Apagados hasta probarlos;
# con CTG puntuales en la pantalla se buscan igual.
VISEC_API_EGRESOS=false
# Plantas (RUCA) que todavia no se informan, separadas por coma. 15125 = Planta
# Silo Acceso Alberti: "por ahora no". Vacio = se informan todas.
VISEC_API_RUCAS_EXCLUIDOS=15125
# Corrida automatica: apagada hasta probarla a mano. En minutos.
VISEC_API_AUTOMATICO=false
VISEC_API_CADA_MINUTOS=15
# Cada corrida mira los ultimos N dias, nunca antes de la fecha inicial
VISEC_API_VENTANA_DIAS=15
VISEC_API_FECHA_INICIAL=
# Cuantas CPE se consultan a ARCA por corrida, y cuantas van por envio
VISEC_API_LIMITE=100
VISEC_API_LOTE=20
